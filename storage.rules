rules_version = '2';

// Fotos do mural de Achados e Perdidos.
// Só moradores ativos na whitelist acessam. A marca "resident" vem no token
// de login (custom claim) e é mantida pelo servidor a partir de residents/{uid}.
service firebase.storage {
  match /b/{bucket}/o {
    function isResident() {
      return request.auth != null && request.auth.token.resident == true;
    }

    match /lostFound/{uid}/{fileName} {
      allow read: if isResident();
      allow create: if isResident()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isResident() && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
